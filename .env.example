export HTTP_PORT="8085"

# Select database: mongodb or postgresql
export DATABASE_DRIVER="postgresql"
export POSTGRES_URI="postgres://backend_challenge:backend_challenge@localhost:5432/backend_challenge?sslmode=disable"

# MongoDB settings (used when DATABASE_DRIVER=mongodb)
export MONGO_URI="mongodb://localhost:27017"
export MONGO_DATABASE="backend_challenge"
export MONGO_USER_COLLECTION="users"
export MONGO_TIMEOUT="10s"

# Select authentication: jwt or oauth2
export AUTH_METHOD="jwt"
export JWT_SECRET="replace-with-a-local-secret"
export JWT_TTL="24h"

# OAuth2 provider settings (used when AUTH_METHOD=oauth2)
export OAUTH2_INTROSPECTION_URL="https://your-provider.example.com/oauth2/introspect"
export OAUTH2_CLIENT_ID="your-resource-server-client-id"
export OAUTH2_CLIENT_SECRET="replace-with-your-client-secret"
export OAUTH2_TIMEOUT="5s"
export OAUTH2_ALLOW_INSECURE_HTTP="false"

# Local OAuth2 mock settings for development. To use it, set AUTH_METHOD=oauth2,
# uncomment these lines, and use the same OAuth2 client ID/secret above.
# export OAUTH2_LOCAL_MOCK="true"
# export OAUTH2_INTROSPECTION_URL="http://127.0.0.1:8090/introspect"
# export OAUTH2_CLIENT_ID="local-mock-client"
# export OAUTH2_CLIENT_SECRET="local-mock-secret"
# export OAUTH2_ALLOW_INSECURE_HTTP="true"
# export OAUTH2_MOCK_ACCESS_TOKEN="local-test-token"

export USER_COUNTER_INTERVAL="30s"
export SHUTDOWN_TIMEOUT="10s"
