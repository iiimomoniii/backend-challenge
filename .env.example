export HTTP_PORT=8085

# Select the database: mongodb or postgresql
export DATABASE_DRIVER="postgresql"
export POSTGRES_URI="postgres://backend_challenge:backend_challenge@localhost:5432/backend_challenge?sslmode=disable"

export MONGO_URI="mongodb://localhost:27017"
export MONGO_DATABASE="backend_challenge"
export MONGO_USER_COLLECTION="users"
export MONGO_TIMEOUT="10s"

# Choose authentication method: jwt or oauth2
export AUTH_METHOD="oauth2"
#JWT
export JWT_SECRET="your-local-secret"
#oAuth
export OAUTH2_LOCAL_MOCK=true
export OAUTH2_INTROSPECTION_URL=http://127.0.0.1:8090/introspect
export OAUTH2_ALLOW_INSECURE_HTTP=true
export OAUTH2_CLIENT_ID=local-mock-client
export OAUTH2_CLIENT_SECRET=local-mock-secret
export OAUTH2_TIMEOUT="5s"

export JWT_TTL="24h"
export USER_COUNTER_INTERVAL="30s"
export SHUTDOWN_TIMEOUT="10s"